# Copy to .env (never commit .env). Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=claims.yourdomain.com
# DJANGO_DB_PATH=/home/youruser/claimapp_data/db.sqlite3
# DJANGO_ADMIN_URL=some-private-path/
# DJANGO_SSL_REDIRECT=1   # only after https works
